<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="GTSDataSync.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <applicationSettings>
    <GTSDataSync.Properties.Settings>
      <setting name="TimerEventInterval" serializeAs="String">
        <value>1000</value>
      </setting>
      <setting name="ControllerHeartbeatInterval" serializeAs="String">
        <value>1000</value>
      </setting>
      <setting name="PropertyFileName" serializeAs="String">
        <value>GTSDataSync.yml</value>
      </setting>
      <setting name="TransmissionTaskTakeTimeout" serializeAs="String">
        <value>10000</value>
      </setting>
      <setting name="MigrationTaskTakeTimeout" serializeAs="String">
        <value>10000</value>
      </setting>
      <setting name="MigrationTaskAddTimeout" serializeAs="String">
        <value>3000</value>
      </setting>
      <setting name="RequestCountThreshold" serializeAs="String">
        <value>1</value>
      </setting>
      <setting name="RequestIntervalAdditionValue" serializeAs="String">
        <value>2000</value>
      </setting>
      <setting name="RequestConnectionTimeout" serializeAs="String">
        <value>30000</value>
      </setting>
      <setting name="ControllerAbortTimeout" serializeAs="String">
        <value>15000</value>
      </setting>
      <setting name="ControllerAbortCheckInterval" serializeAs="String">
        <value>1000</value>
      </setting>
      <setting name="DatabaseFileName" serializeAs="String">
        <value>GTSDataSync.db</value>
      </setting>
      <setting name="LoggingDirectoryPath" serializeAs="String">
        <value>C:\Users\Public\Documents\Techstream\DataSyncTmp\Log</value>
      </setting>
      <setting name="ServiceName" serializeAs="String">
        <value>GTS DataSync</value>
      </setting>
      <setting name="TransmissionTaskStopConfirmationInterval" serializeAs="String">
        <value>1000</value>
      </setting>
    </GTSDataSync.Properties.Settings>
  </applicationSettings>
  <log4net>
    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <ConversionPattern value="%utcdate{yyyy,MM,dd,HH,mm,ss,fff},%message%n" />
      </layout>
    </appender>
    <appender name="FileAppender" type="GTSDataSync.Common.Extension.HeaderOnceAppender">
      <File value="C:\Users\Public\Documents\Techstream\DataSyncTmp\Log\GTSDataSync_" />
      <DatePattern value="yyyyMMdd&quot;.log&quot;" />
      <StaticLogFileName value="false" />
      <RollingStyle value="date" />
      <AppendToFile value="true" />
      <MaxSizeRollBackups value="-1" />
      <layout type="log4net.Layout.PatternLayout">
        <header value="&quot;Year&quot;,&quot;Month&quot;,&quot;Day&quot;,&quot;Hour&quot;,&quot;Min&quot;,&quot;Sec&quot;,&quot;mSec&quot;,&quot;Exe&quot;,&quot;Error Level&quot;,&quot;Module Name&quot;,&quot;Thread No&quot;,&quot;Parameter1&quot;,&quot;Parameter2&quot;,&quot;Content&quot;&#xD;&#xA;" />
        <ConversionPattern value="%utcdate{yyyy,MM,dd,HH,mm,ss,fff},%message%n" />
      </layout>
      <encoding type="System.Text.UTF8Encoding" />
    </appender>
    <root>
      <level value="info" />
      <appender-ref ref="ConsoleAppender" />
      <appender-ref ref="FileAppender" />
    </root>
  </log4net>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.ComponentModel.Annotations" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.1.0" newVersion="4.2.1.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>