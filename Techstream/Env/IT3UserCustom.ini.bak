;===========================================================================;
;Startup Setting
;===========================================================================;
[RunSetting]
RunTime=1

;===========================================================================;
;Region
;===========================================================================;
[Region]
Region=North America
RegionID=1
RegionCode=NA

;===========================================================================;
;SHOP Information
;===========================================================================;
[shopInformation]
name=
DealerCode=
DealerPhone=
DealerCountry=
DealerCountryID=
DealerCountryCode=
address=
url=
email=
DealerType=
DefaultBrand=

;===========================================================================;
;User Information
;===========================================================================;
[user]
userNum=1
IDMax=1

;===========================================================================;
;Current User
;===========================================================================;
[currentUser]
ID=1

;===========================================================================;
;VIM Driver
;===========================================================================;
[VIMDriver]
Name=TIS Techstream VIM
Device=SOFTWARE\PassThruSupport.04.04\DENSO CORPORATION - TIS Techstream VIM

;===========================================================================;
;ErrorReport Seting
;===========================================================================;
[ErrorReport]
InternalLogDir=C:\Users\Public\Documents\Techstream\ErrorReport
InternalLogSize=409600
ErrorLogDir=C:\Users\Public\Documents\Techstream\ErrorReport
CapNormalVirtualKey=123
CapNormalModifier=0x00
CapOnlyVirtualKey=145
CapOnlyModifier=0x00
ShowFlag=0
FreezeChkResponseTimeOut=360000
LiveChkIntervalTime=2
ShareMemSize=512000
SendTisDir=C:\Users\Public\Documents\Techstream\ErrorReport
WorkTisDir=C:\Users\Public\Documents\Techstream\ErrorReport
LogIndexMaxSize=8

;=================================
;user1 Profile setting
;=================================
[user1Profile]
firstName=Default
lastName=User
techNum=1
defaultDir=C:\Users\Public\Documents\Techstream\UserSetting\Default_User
SavedFileDir=C:\Users\Public\Documents\Techstream\USER\Default_User

